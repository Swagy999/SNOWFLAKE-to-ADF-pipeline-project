{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "VB-B11A-ETL-DEV"
		},
		"LS_SFTP_ADLS_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SFTP_ADLS_PARQUET'"
		},
		"LS_SFTP_SINK_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SFTP_SINK_PARQUET'"
		},
		"LS_SNWFLK_PARQUET_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SNWFLK_PARQUET'"
		},
		"LS_SQL_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SQL_ADLS'"
		},
		"LS_SqlServerTable_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SqlServerTable'"
		},
		"LS_SFTP_ADLS_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsstotragesourcesftp01.dfs.core.windows.net/"
		},
		"LS_SFTP_SINK_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsvbstoragesesource001.dfs.core.windows.net/"
		},
		"LS_SINK_SNOWFLAKE_PARQUET_sasUri": {
			"type": "secureString",
			"metadata": "Secure string for 'sasUri' of 'LS_SINK_SNOWFLAKE_PARQUET'"
		},
		"LS_SNWFLK_PARQUET_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DBAZURESNOW"
		},
		"LS_SQL_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsvbstoragesesource001.dfs.core.windows.net/"
		},
		"LS_SqlServerTable_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "SWAGGY\\SQLEXPRESS"
		},
		"LS_SqlServerTable_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "vbfinalproject"
		},
		"LS_SqlServerTable_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adfadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "VB-B11A-ETL-DEV_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SFTP_ADLS_PARQUET_accountKey": {
						"value": "[parameters('LS_SFTP_ADLS_PARQUET_accountKey')]"
					},
					"LS_SFTP_SINK_PARQUET_accountKey": {
						"value": "[parameters('LS_SFTP_SINK_PARQUET_accountKey')]"
					},
					"LS_SNWFLK_PARQUET_password": {
						"value": "[parameters('LS_SNWFLK_PARQUET_password')]"
					},
					"LS_SQL_ADLS_accountKey": {
						"value": "[parameters('LS_SQL_ADLS_accountKey')]"
					},
					"LS_SqlServerTable_password": {
						"value": "[parameters('LS_SqlServerTable_password')]"
					},
					"LS_SFTP_ADLS_PARQUET_properties_typeProperties_url": {
						"value": "[parameters('LS_SFTP_ADLS_PARQUET_properties_typeProperties_url')]"
					},
					"LS_SFTP_SINK_PARQUET_properties_typeProperties_url": {
						"value": "[parameters('LS_SFTP_SINK_PARQUET_properties_typeProperties_url')]"
					},
					"LS_SINK_SNOWFLAKE_PARQUET_sasUri": {
						"value": "[parameters('LS_SINK_SNOWFLAKE_PARQUET_sasUri')]"
					},
					"LS_SNWFLK_PARQUET_properties_typeProperties_database": {
						"value": "[parameters('LS_SNWFLK_PARQUET_properties_typeProperties_database')]"
					},
					"LS_SQL_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_SQL_ADLS_properties_typeProperties_url')]"
					},
					"LS_SqlServerTable_properties_typeProperties_server": {
						"value": "[parameters('LS_SqlServerTable_properties_typeProperties_server')]"
					},
					"LS_SqlServerTable_properties_typeProperties_database": {
						"value": "[parameters('LS_SqlServerTable_properties_typeProperties_database')]"
					},
					"LS_SqlServerTable_properties_typeProperties_userName": {
						"value": "[parameters('LS_SqlServerTable_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}